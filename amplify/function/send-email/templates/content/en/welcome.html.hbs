<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Welcome to Bafatorio, {{eventManagerName}}!</title>
    <!--[if mso]>
    <style type="text/css">
        body, table, td { font-family: Arial, sans-serif !important; }
    </style>
    <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f4f5f7; font-family: 'Segoe UI', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f5f7;">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%;">

                    <!-- Logo -->
                    <tr>
                        <td style="padding-bottom: 32px; text-align: center;">
                            <img src="https://bafatorio-public-assets.s3.eu-west-1.amazonaws.com/brand/bafatorio.png" alt="Bafatorio" width="48" height="48" style="display: inline-block; border: 0; outline: none;">
                        </td>
                    </tr>

                    <!-- Card -->
                    <tr>
                        <td style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e5e9;">

                            <!-- Content -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="padding: 40px 40px 0;">
                                        <h1 style="font-size: 22px; color: #1a1a1a; margin: 0 0 24px; font-weight: 600;">Welcome to Bafatorio</h1>
                                        <p style="font-size: 15px; color: #4a4a4a; line-height: 1.7; margin: 0 0 16px;">Hello {{eventManagerName}},</p>
                                        <p style="font-size: 15px; color: #4a4a4a; line-height: 1.7; margin: 0 0 24px;">Your account has been successfully created. You can now access the platform and start organising your events.</p>
                                    </td>
                                </tr>

                                <!-- Features -->
                                <tr>
                                    <td style="padding: 0 40px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8f9fa; border-radius: 6px;">
                                            <tr>
                                                <td style="padding: 24px;">
                                                    <p style="font-size: 14px; color: #1a1a1a; font-weight: 600; margin: 0 0 14px;">With Bafatorio you can:</p>
                                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">&#8226;&nbsp;&nbsp;Create and manage corporate events, conferences and meetings</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">&#8226;&nbsp;&nbsp;Centralise participant management and communications</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">&#8226;&nbsp;&nbsp;Access detailed reports and statistics</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #4a4a4a; line-height: 1.6;">&#8226;&nbsp;&nbsp;Collaborate with your team in real time</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- CTA -->
                                <tr>
                                    <td style="padding: 28px 40px 0;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="background-color: #0093EB; border-radius: 6px;">
                                                    <a href="https://bafatorio.com/app" target="_blank" style="display: inline-block; padding: 12px 28px; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none;">Access the platform</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Closing -->
                                <tr>
                                    <td style="padding: 28px 40px 0;">
                                        <p style="font-size: 14px; color: #4a4a4a; line-height: 1.7; margin: 0;">If you need any help, reply to this email or contact our support team.</p>
                                    </td>
                                </tr>

                                <!-- Signature -->
                                <tr>
                                    <td style="padding: 28px 40px 40px;">
                                        <p style="font-size: 14px; color: #4a4a4a; line-height: 1.6; margin: 0;">Best regards,<br><strong style="color: #1a1a1a;">The Bafatorio Team</strong></p>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 0; text-align: center;">
                            <p style="font-size: 12px; color: #999; margin: 0;">&copy; 2026 Bafatorio. All rights reserved.</p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
